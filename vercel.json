{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/tasks/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/status",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}